---
import { Image, getImage } from 'astro:assets';
import { render } from 'astro:content';
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import { SECTIONS, published, fmtDate, type Section } from '../lib';

const { entry, section }: { entry: any; section: Section } = Astro.props;
const d = entry.data;
const { Content } = await render(entry);
const site = Astro.site!;
const url = new URL(`/${section}/${entry.id}/`, site).href;
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const ogUrl = new URL(og.src, site).href;

// Up to three more from the same section: shared tags first, then the newest.
const shared = (e: any) => e.data.tags.filter((t: string) => d.tags.includes(t)).length;
const related = (await published(section))
  .filter((e) => e.id !== entry.id)
  .sort((a, b) => shared(b) - shared(a))
  .slice(0, 3);

const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'Article',
      headline: d.title,
      description: d.description,
      image: [ogUrl],
      datePublished: d.date.toISOString(),
      dateModified: (d.updated ?? d.date).toISOString(),
      author: d.author === 'X-ON-X'
        ? { '@id': 'https://www.x-on-x.com/#org' }
        : { '@type': 'Person', name: d.author, worksFor: { '@id': 'https://www.x-on-x.com/#org' } },
      publisher: { '@id': 'https://www.x-on-x.com/#org' },
      mainEntityOfPage: url,
      keywords: d.tags.join(', ') || undefined,
      inLanguage: 'en',
    },
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'X-ON-X', item: new URL('/', site).href },
        { '@type': 'ListItem', position: 2, name: SECTIONS[section].name, item: new URL(`/${section}/`, site).href },
        { '@type': 'ListItem', position: 3, name: d.title, item: url },
      ],
    },
    {
      '@type': 'Organization',
      '@id': 'https://www.x-on-x.com/#org',
      name: 'X-ON-X',
      url: 'https://www.x-on-x.com/',
      logo: 'https://www.x-on-x.com/img/apple-touch-icon.png',
    },
  ],
};
---
<Base title={`${d.title} | X-ON-X`} description={d.description} image={ogUrl} type="article" jsonld={jsonld}>
  <article>
    <header class="article-head">
      <div class="eyebrow"><a href="/">X-ON-X</a> / <a href={`/${section}/`}>{SECTIONS[section].name}</a></div>
      <h1>{d.title}</h1>
      <p class="lede">{d.description}</p>
      <div class="byline eyebrow">
        <span>{d.author}</span>
        <time datetime={d.date.toISOString()}>{fmtDate(d.date)}</time>
        {d.client && <span>Client: {d.client}</span>}
        {d.sector && <span>{d.sector}</span>}
      </div>
      {d.tags.length > 0 && <div class="tags">{d.tags.map((t: string) => <span class="tag">{t}</span>)}</div>}
    </header>
    <div class="article-cover">
      <Image src={d.cover} alt={d.coverAlt} widths={[800, 1240, 2000]} sizes="(max-width: 1240px) 100vw, 1240px" loading="eager" fetchpriority="high" />
    </div>
    <div class="prose"><Content /></div>
  </article>
  <section class="cta">
    <div class="cta__box">
      <p>Facing something similar? Talk to the partner who would work on it.</p>
      <a class="xx-btn" href="https://t.me/yourxsolution" target="_blank" rel="noopener noreferrer">Come on in &rarr;</a>
    </div>
  </section>
  {related.length > 0 && (
    <section class="more">
      <div class="wrap">
        <h2>More {SECTIONS[section].name.toLowerCase()}</h2>
        <div class="cards">{related.map((e) => <Card entry={e} section={section} />)}</div>
      </div>
    </section>
  )}
</Base>
