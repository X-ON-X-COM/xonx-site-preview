---
import Base from '../layouts/Base.astro';
import Card from './Card.astro';
import { SECTIONS, published, type Section } from '../lib';
const section: Section = Astro.props.section;
const { name, lede } = SECTIONS[section];
const entries = await published(section);
const site = Astro.site!;
const jsonld = {
  '@context': 'https://schema.org',
  '@type': 'CollectionPage',
  name: `${name} | X-ON-X`,
  url: new URL(`/${section}/`, site).href,
  isPartOf: { '@id': 'https://www.x-on-x.com/#site' },
  mainEntity: {
    '@type': 'ItemList',
    itemListElement: entries.map((e, i) => ({
      '@type': 'ListItem', position: i + 1, url: new URL(`/${section}/${e.id}/`, site).href,
    })),
  },
};
---
<Base title={`${name} | X-ON-X`} description={lede} jsonld={jsonld}>
  <div class="wrap">
    <header class="list-head">
      <div class="eyebrow"><a href="/">X-ON-X</a> / {name}</div>
      <h1>{name}</h1>
      <p>{lede}</p>
    </header>
    {entries.length
      ? <div class="cards">{entries.map((e) => <Card entry={e} section={section} />)}</div>
      : <p class="empty">First articles are on the way.</p>}
  </div>
</Base>
