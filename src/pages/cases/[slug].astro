---
import Base from '../../layouts/Base.astro';
import CasePanel from '../../components/CasePanel.astro';
import { published } from '../../lib';
import { getImage } from 'astro:assets';
import '../../styles/cases.css';
export async function getStaticPaths() {
  return (await published('cases')).map((entry) => ({ params: { slug: entry.id }, props: { entry } }));
}
const { entry } = Astro.props;
const d = entry.data;
const metaDescription = d.seoDescription ?? d.description;
const og = await getImage({ src: d.cover, width: 1200, height: 630, fit: 'cover', format: 'jpg' });
const site = Astro.site!;
const url = new URL(`/cases/${entry.id}/`, site).href;
const jsonld = {
  '@context': 'https://schema.org',
  '@graph': [
    { '@type': 'Article', headline: d.title, description: metaDescription, image: [new URL(og.src, site).href],
      datePublished: d.date.toISOString(), dateModified: (d.updated ?? d.date).toISOString(),
      author: { '@id': 'https://www.x-on-x.com/#org' }, publisher: { '@id': 'https://www.x-on-x.com/#org' },
      mainEntityOfPage: url, inLanguage: 'en' },
    { '@type': 'BreadcrumbList', itemListElement: [
      { '@type': 'ListItem', position: 1, name: 'X-ON-X', item: new URL('/', site).href },
      { '@type': 'ListItem', position: 2, name: 'Cases', item: new URL('/cases/', site).href },
      { '@type': 'ListItem', position: 3, name: d.title, item: url } ] },
    { '@type': 'Organization', '@id': 'https://www.x-on-x.com/#org', name: 'X-ON-X', url: 'https://www.x-on-x.com/',
      logo: 'https://www.x-on-x.com/img/apple-touch-icon.png' },
  ],
};
---
<Base title={`${d.title} | X-ON-X`} description={metaDescription} image={new URL(og.src, site).href} type="article" jsonld={jsonld}>
  <div class="case-wrap">
    <div class="eyebrow case-crumbs"><a href="/">X-ON-X</a> / <a href="/cases/">Cases</a></div>
    <CasePanel entry={entry} mode="page" />
  </div>
  <script is:inline src="/js/cases.js" defer></script>
</Base>
